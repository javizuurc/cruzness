{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "context-mode"
  ],
  "mcp": {
    "context-mode": {
      "command": [
        "context-mode",
        "server",
        "--agent",
        "opencode"
      ],
      "enabled": true,
      "type": "local"
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "enabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  }
}
